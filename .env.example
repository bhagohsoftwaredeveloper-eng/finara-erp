# ─── Server (Express API runs internally on :5000) ───────────
NODE_ENV=development

# Database (MySQL/MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/ph_erp_db"

# JWT — generate strong random secrets for production
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Frontend URL (dev only; in the unified build the UI is same-origin)
FRONTEND_URL=http://localhost:3000

# ─── Email (optional — enables password-reset, invoice & reminder emails) ──
# Leave SMTP_HOST blank to disable email; the app degrades gracefully.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finara ERP <no-reply@yourcompany.com>"
APP_URL=http://localhost:3000

# ─── Lead webhook (optional — forwards new marketing leads to an external app) ──
# Leave LEAD_WEBHOOK_URL blank to disable; the feature no-ops silently.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ─── PayMongo (optional — enables online payment links for business licenses) ──
# Leave PAYMONGO_SECRET_KEY blank to disable; SUPER_ADMIN can still activate licenses manually.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Static key for GET /api/leads/export (X-API-Key header, machine-to-machine).
# Leave blank to disable the endpoint entirely (it will 404).
LEAD_EXPORT_API_KEY=

# ─── Beulah (external system — Employee Info API, read-only) ────────────────
# Server-only, never NEXT_PUBLIC_*. Leave blank to disable Payroll > Employees
# (the directory page will show a load error).
BEULAH_PAYROLL_BASE_URL=
BEULAH_PAYROLL_API_TOKEN=

# ─── Database backups (npm run db:backup) ────────────────────
# Full path to mysqldump if not on PATH; number of dumps to keep.
MYSQLDUMP_PATH="C:/Program Files/MySQL/MySQL Server 9.4/bin/mysqldump.exe"
BACKUP_RETENTION=14

# ─── PO Scanner (OCR, server/ocr/parse_po.py) ────────────────
# Requires Python 3 with `pytesseract` + `Pillow`, and the Tesseract OCR
# engine itself installed separately (not a pip package). Leave blank to
# use `tesseract` from PATH, or the default Windows install location.
TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"

# Company defaults
DEFAULT_COMPANY_NAME="Your Company Name"
DEFAULT_COMPANY_TIN="000-000-000-000"
DEFAULT_COMPANY_ADDRESS="Manila, Philippines"

# ─── Frontend (Next.js) ──────────────────────────────────────
# Server-side proxy target for /api/* (see next.config.js rewrites).
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME="PH-ERP Accounting"
NEXT_PUBLIC_COMPANY_NAME="Your Company Name"
